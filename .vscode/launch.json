{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KAIROS：后端 API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/server/index.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },
    {
      "name": "KAIROS：前端 React",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:4173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "KAIROS：启动前端开发服务器",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "KAIROS：全栈调试",
      "configurations": [
        "KAIROS：后端 API",
        "KAIROS：前端 React"
      ],
      "stopAll": true
    }
  ]
}
