API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:4173
API_DOCS_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

AUTH_ENABLED=true
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_TTL_SECONDS=28800
# Local HTTP only. Production startup requires true and an HTTPS reverse proxy.
AUTH_COOKIE_SECURE=false
AUTH_MAX_SESSIONS=3
AUTH_LOGIN_RATE_LIMIT_MAX=5

MARKET_MODE=mock
MARKET_DATA_PROVIDER=mock
MARKET_TICK_MS=1000
MARKET_DATA_TIMEOUT_MS=15000
MARKET_SYMBOLS=600519,000858,300750,601318,000001,600036,002594,688981,601899,600276,601012,002475,000651,000333,000725,002415,002230,002714,002352,300059,300760,300274,300015,300124,600030,601166,601398,601288,600887,600309,600438,600585,600690,600050,600104,601766,601668,601088,601857,600900,600905,000063,000977,000938,002371,002410,002460,002466,002129,002241,002271,300308,300316,300408,300433,300496,300502,688008,688012,688036,688111,688126,688169,688223,688256,688271,688303
AKSHARE_BRIDGE_URL=http://127.0.0.1:8800
AKSHARE_BRIDGE_TOKEN=
AKSHARE_BRIDGE_DISABLE_PROXY=true
AKSHARE_BRIDGE_CACHE_TTL=10
AKSHARE_BRIDGE_RESEARCH_CACHE_TTL=900
AKSHARE_BRIDGE_RESEARCH_CACHE_STALE_TTL=3600
AKSHARE_BRIDGE_RESEARCH_CACHE_MAX_ENTRIES=64
AKSHARE_BRIDGE_HISTORY_CACHE_MAX_ENTRIES=128
AKSHARE_BRIDGE_HISTORY_FETCH_MAX_ACTIVE=2
AKSHARE_BRIDGE_HISTORY_FETCH_MAX_PENDING=24
AKSHARE_BRIDGE_HISTORY_RESPONSE_BUDGET=6
AKSHARE_BRIDGE_HISTORY_PROVIDER_TIMEOUT=8
TRADING_STARTING_CASH=1000000
TRADING_SEED_PORTFOLIO=true

MAX_ORDER_NOTIONAL=100000
MAX_POSITION_WEIGHT=0.25
MAX_DAILY_LOSS=0.05
COMMISSION_RATE=0.0003
MIN_COMMISSION=5
SLIPPAGE_BPS=5

REAL_TRADING_ENABLED=false

# Local paper auto execution. The cash reserve is a fraction of current equity.
PAPER_AUTO_EXECUTION_ENABLED=false
PAPER_AUTO_EXECUTION_INTERVAL_MS=60000
PAPER_AUTO_EXECUTION_TRADE_WINDOW_ONLY=true
PAPER_AUTO_EXECUTION_MAX_ORDERS_PER_RUN=1
PAPER_AUTO_EXECUTION_MAX_DAILY_ORDERS=4
PAPER_AUTO_EXECUTION_TARGET_DAILY_ORDERS=2
PAPER_AUTO_EXECUTION_ACTIVITY_MODE=observe
PAPER_AUTO_EXECUTION_CASH_RESERVE_RATIO=0.10

# Optional personal WxPusher SPT notifications before actionable local paper plans.
# Keep the real SPT in .env.local only. Never commit or expose it to VITE_*.
WXPUSHER_ENABLED=false
WXPUSHER_SPT=
WXPUSHER_TIMEOUT_MS=5000
WXPUSHER_DAILY_MESSAGE_LIMIT=10

# Runtime logs are pruned before local dev startup. Recently written files are protected.
RUNTIME_LOG_DIR=./logs
RUNTIME_LOG_RETENTION_DAYS=7
RUNTIME_LOG_MAX_TOTAL_MB=100
RUNTIME_LOG_MAX_FILE_MB=20

# Trading state backend: memory (default) or json (local single-process persistence).
STORE_BACKEND=memory
DATA_DIR=./data
# Completed paper orders and audit events are retained for seven days by default.
# Account cash, current positions, paused state, and open orders are not expired.
TRADING_HISTORY_RETENTION_DAYS=7

# Research data cache: bounded by default so historical training does not dump junk locally.
RESEARCH_DATA_DIR=./data/research
RESEARCH_MAX_SYMBOLS=200
RESEARCH_HISTORY_DAYS=756
RESEARCH_MAX_CACHE_MB=512
RESEARCH_STORE_RAW_NEWS=false

# Optional compact external-market research samples. Only valid in paper + akshare mode.
EXTERNAL_MARKET_FEATURE_CAPTURE_ENABLED=false
EXTERNAL_MARKET_FEATURE_MAX_ROWS=750
EXTERNAL_MARKET_FEATURE_FILE=./data/research/external-market-features.json

# Future provider credentials. Keep actual values in .env.local only.
TUSHARE_TOKEN=
BROKER_API_KEY=
BROKER_API_SECRET=
