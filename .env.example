API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:4173
API_DOCS_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

MARKET_MODE=mock
MARKET_DATA_PROVIDER=mock
MARKET_TICK_MS=1000
MARKET_DATA_TIMEOUT_MS=15000
MARKET_SYMBOLS=600519,000858,300750,601318,000001,600036,002594,688981
AKSHARE_BRIDGE_URL=http://127.0.0.1:8800
AKSHARE_BRIDGE_TOKEN=
AKSHARE_BRIDGE_DISABLE_PROXY=true
TRADING_STARTING_CASH=1000000

MAX_ORDER_NOTIONAL=100000
MAX_POSITION_WEIGHT=0.25
MAX_DAILY_LOSS=0.05
COMMISSION_RATE=0.0003
MIN_COMMISSION=5
SLIPPAGE_BPS=5

REAL_TRADING_ENABLED=false

# Authentication prototype. The main app does not register these routes yet.
# Fill all values before future enablement; no default credentials are allowed.
AUTH_USERNAME=
AUTH_PASSWORD=
JWT_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# Trading state backend: memory (default) or json (local single-process persistence).
STORE_BACKEND=memory
DATA_DIR=./data

# Future provider credentials. Keep actual values in .env.local only.
TUSHARE_TOKEN=
BROKER_API_KEY=
BROKER_API_SECRET=
